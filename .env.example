DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
# development.py: ALLOWED_HOSTS=* e CSRF com localhost + deteção automática do IP da LAN
# (DEV_AUTO_LAN_CSRF=1 por omissão). Se usar outra porta: export RUNSERVER_PORT=8001 antes do runserver.
# Reforço manual (opcional): LAN_ORIGIN=http://192.168.1.5:8000
# Arranque: ./scripts/runserver-lan.sh (imprime a URL; exporta RUNSERVER_PORT e LAN_ORIGIN)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker compose uses these)
POSTGRES_DB=caminhao_pipa
POSTGRES_USER=caminhao_pipa
POSTGRES_PASSWORD=caminhao_pipa
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local development without Docker: use localhost and run Postgres locally
# POSTGRES_HOST=localhost
