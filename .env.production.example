# Copiar para .env no servidor (/home/josue/trw/.env) e ajustar.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=troque-por-chave-longa-aleatoria
DEBUG=0
ALLOWED_HOSTS=trw.seudominio.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://trw.seudominio.com.br

POSTGRES_DB=caminhao_pipa_trw
POSTGRES_USER=caminhao_pipa_trw
POSTGRES_PASSWORD=troque-senha-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Isolamento Docker (não reutilizar nome de outros projetos no servidor)
COMPOSE_PROJECT_NAME=trw

# Porta HTTP só em localhost — faixa sugerida 18080–18119 (ver scripts/check-trw-port.sh)
TRW_BIND=127.0.0.1
TRW_WEB_PORT=18080
